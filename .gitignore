# ==========================================
# Root .gitignore for Food Delivery Project
# ==========================================

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Java / Spring Boot Build Artifacts
**/target/
foodapi/target/
foodapi/bin/
*.class
*.jar
*.war
*.ear

# Node / Vite Frontend Artifacts
**/node_modules/
**/dist/
foodies/node_modules/
foodies/dist/
adminpanel/node_modules/
adminpanel/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Crash & Replay logs
*.log
hs_err_pid*.log
replay_pid*.log

# IDE & Editor files
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Eclipse
.project
.classpath
.settings/

# Temporary / OS
tmp/
temp/
